      "http://*.seedhangyan.com",
      "https://*.seedhangyan.com",
      "http://*.rongdasoft.com",
      "https://*.rongdasoft.com",
      "http://*.qcc.com",
      "https://*.qcc.com",
      "http://*.cninfo.com.cn",
      "https://*.cninfo.com.cn"
    ]
  },
  "permissions": ["core:event:default"]
}
